# Public origin URL of the site (without trailing slash)
# Example: https://argatanimandiri.co.id
SITE_URL=

# Indexing switch ("on" to enable search engine indexing at launch; defaults to "off")
SITE_INDEXING=off

# Supabase public project credentials (safe for browser/SSR use; never put service_role here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional custom admin panel slug (lowercase letters, digits, hyphen; 3-40 chars).
# Defaults to "atm-kelola" when omitted. Note: NEXT_PUBLIC_ values are sent to the browser,
# so this path is obscure rather than secret.
NEXT_PUBLIC_ADMIN_PATH=atm-kelola

